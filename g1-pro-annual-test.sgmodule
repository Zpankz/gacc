#!name=G1 Pro Annual Test
#!desc=v7.6.0 compatibility entry: uses the same three-tier G1 ACQ script, supports the Ultra 1-month free trial, 20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq, each tier independently falling back to the three-month 90p fallback; 2TB 12-month offer test target g1.2tb.ai.12months_ip_90p (no .acq); passive collection within the original /ai? scope, with most recent 10 responses / new in this response / duplicate diagnostics; the current main module is g1-acq-v7.sgmodule - enable just one; does not actively query the full SKU catalogue
#!system=ios

[Rule]
# Same as the old module: blocks UDP 443, applying to traffic using this configuration.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
