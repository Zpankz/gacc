#!name=G1 ACQ
#!desc=v7.6.0: Supports the Ultra 1-month free trial, 20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq, each tier independently falling back to the three-month 90p fallback; 2TB 12-month offer test g1.2tb.ai.12months_ip_90p (no .acq); passive collection of original SKUs, most recent 10 responses / new in this response / duplicate diagnostics; local report and JSON export; does not actively query the full SKU catalogue
#!system=ios

[Rule]
# Block UDP 443 to make HTTP/3 requests that support fallback use TCP instead.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
